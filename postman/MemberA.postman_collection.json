{
  "info": {
    "name": "Thành viên A – Modules 3 4 5 10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flask + MySQL theo báo cáo. Chạy Auth đầu tiên, điền owner credentials. ID được lưu tự động. Upload chọn lại file sample.png trong Postman. Các request kiểm tra lỗi có trạng thái kỳ vọng ghi trong tên."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health",
            "description": "Kỳ vọng HTTP 200. Xem docs/api.md về body, quyền và ý nghĩa trạng thái.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Lấy CSRF trước Login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/csrf",
            "description": "Kỳ vọng HTTP 200. Xem docs/api.md về body, quyền và ý nghĩa trạng thái.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"login_csrf\", data.csrf_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login OWNER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{login_csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/login",
            "description": "Kỳ vọng HTTP 200. Xem docs/api.md về body, quyền và ý nghĩa trạng thái.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"token\", data.token);",
                  "pm.environment.set(\"csrf_token\", data.csrf_token);",
                  "pm.environment.set(\"shop_id\", data.shop_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Tài khoản hiện tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/me",
