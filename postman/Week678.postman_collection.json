{
  "info": {
    "name": "ShopFlow Tuần 6–8 POS Order Payment Invoice Inventory Report Subscription",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "01 CSRF và biến chạy",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.environment.set('csrf_token', body.data.csrf_token);",
              "pm.environment.set('run_code', 'PM'+Date.now()); pm.environment.set('checkout_key', pm.variables.replaceIn('{{$guid}}')); pm.environment.set('order_key', pm.variables.replaceIn('{{$guid}}')); pm.environment.set('payment_key', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login OWNER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner.demo@example.com\",\n  \"password\": \"DemoOwner123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.environment.set('owner_token', body.data.token);",
              "pm.environment.set('shop_id', body.data.shop_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Tạo Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": "{{base_url}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_code\": \"{{run_code}}\",\n  \"product_name\": \"Sản phẩm Postman {{run_code}}\",\n  \"price\": \"19.90\",\n  \"stock_quantity\": 10,\n  \"min_stock\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('product_id', body.data.product_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Đọc giỏ",
      "request": {
