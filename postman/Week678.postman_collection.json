          "mode": "raw",
          "raw": "{\n  \"cart_id\": \"{{cart_id}}\",\n  \"version\": \"{{cart_version}}\",\n  \"expected_total_amount\": \"{{expected_total}}\",\n  \"discount_amount\": \"4.80\",\n  \"payment\": {\n    \"payment_method\": \"CASH\",\n    \"tendered_amount\": \"50.00\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
