            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('order_id', body.data.order_id);",
              "pm.environment.set('order_code', body.data.order_code);",
              "pm.environment.set('invoice_id', body.data.invoice_id);",
              "pm.test('Thừa 15.00',()=>pm.expect(body.data.payments[0].change_amount).to.eql('15.00'));"
            ]
          }
        }
      ]
