    {
      "name": "ADMIN tìm danh sách shop",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ws_admin_token}}"
          }
        ],
        "url": "{{base_url}}/api/admin/shops?q=owner&per_page=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Không lộ thông tin xác thực\",()=>{const text=pm.response.text();for(const key of [\"password_hash\",\"csrf_token\",\"session_id\"])pm.expect(text).not.to.include(key);});"
            ]
          }
        }
      ]
    },
    {
      "name": "ADMIN chi tiết shop",
      "request": {
        "method": "GET",
        "header": [
