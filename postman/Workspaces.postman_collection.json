          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.environment.set(\"ws_owner_id\",body.data.owner.user_id);",
              "pm.test(\"Có chủ shop, thời gian và gói hiệu lực\",()=>{pm.expect(body.data.owner.username).to.be.a(\"string\");pm.expect(body.data.usage_days).to.be.at.least(0);pm.expect(body.data.subscription.effective_plan).to.be.oneOf([\"STANDARD\",\"PRO\"]);});"
            ]
          }
        }
      ]
    },
