{
  "info": {
    "name": "ShopFlow — Hai giao diện, người bán và quản trị shop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy trên CSDL demo có seed. Kiểm thử mới; không đổi gói hay sửa dữ liệu nghiệp vụ."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "CSRF OWNER",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.environment.set(\"ws_csrf\",body.data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login OWNER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{ws_csrf}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner.demo@example.com\",\n  \"password\": \"DemoOwner123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.environment.set(\"ws_owner_token\",body.data.token);",
              "pm.test(\"Vai trò và trang chủ\",()=>{pm.expect(body.data.role_name).to.eql(\"OWNER\");pm.expect(body.redirect_url).to.eql(\"/pos\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "OWNER báo cáo người bán",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ws_owner_token}}"
          }
        ],
        "url": "{{base_url}}/api/reports/sellers?range=month"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Phân trang và tổng doanh số\",()=>{pm.expect(body.meta).to.have.property(\"total\");pm.expect(body.summary.total_revenue).to.be.a(\"string\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "OWNER không xem toàn nền tảng",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ws_owner_token}}"
          }
        ],
        "url": "{{base_url}}/api/admin/shops"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));",
              "const body=pm.response.json();"
            ]
          }
        }
      ]
    },
