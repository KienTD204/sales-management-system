{
  "info": {
    "name": "Tuần 5 Thành viên A – Auth và phân quyền",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy trên dữ liệu database_schema.sql. Registration tạo SHOP mới, mặc định OWNER. Cần đổi register_shop_code/username/email khi chạy lại. Script kiểm tra status, role, điều hướng, cookie, bảo vệ route và token sau logout."
  },
  "item": [
    {
      "name": "Chưa đăng nhập – 401",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/me",
        "auth": {
          "type": "noauth"
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const response = pm.response.json();",
              "pm.test(\"JSON envelope\", () => pm.expect(response).to.have.property(\"status\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Lấy CSRF trước xác thực",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/csrf",
        "auth": {
          "type": "noauth"
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const response = pm.response.json();",
              "pm.test(\"JSON envelope\", () => pm.expect(response).to.have.property(\"status\"));",
              "if (pm.response.code === 200) {",
              "pm.environment.set(\"preauth_csrf\", response.data.csrf_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Đăng ký OWNER – 201",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{preauth_csrf}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shop_code\": \"{{register_shop_code}}\",\n  \"shop_name\": \"Cửa hàng đăng ký Postman\",\n  \"username\": \"{{register_username}}\",\n  \"email\": \"{{register_email}}\",\n  \"full_name\": \"Chủ shop Postman\",\n  \"phone\": \"0901234567\",\n  \"password\": \"{{register_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const response = pm.response.json();",
              "pm.test(\"JSON envelope\", () => pm.expect(response).to.have.property(\"status\"));",
              "if (pm.response.code === 201) {",
              "pm.environment.set(\"registered_user_id\", response.data.user_id);",
              "pm.environment.set(\"registered_shop_id\", response.data.shop_id);",
              "}",
              "pm.test(\"Chỉ tạo OWNER\", () => pm.expect(response.data.role_name).to.eql(\"OWNER\"));",
              "pm.test(\"Về Login sau đăng ký\", () => pm.expect(response.redirect_url).to.eql(\"/login\"));",
              "pm.test(\"Chưa cấp phiên, không lộ mật khẩu\", () => { pm.expect(response.data).not.to.have.property(\"token\"); pm.expect(JSON.stringify(response)).not.to.include(pm.environment.get(\"register_password\")); });"
            ]
          }
        }
      ]
    },
