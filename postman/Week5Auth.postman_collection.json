              "const response = pm.response.json();",
              "pm.test(\"JSON envelope\", () => pm.expect(response).to.have.property(\"status\"));",
              "if (pm.response.code === 200) {",
              "pm.environment.set(\"owner_token\", response.data.token);",
              "}",
              "pm.test(\"Đúng vai trò và điều hướng\", () => { pm.expect(response.data.role_name).to.eql(\"OWNER\"); pm.expect(response.redirect_url).to.eql(\"/pos\"); });",
              "pm.test(\"Không trả hash\", () => pm.expect(JSON.stringify(response)).not.to.include(\"password_hash\"));",
              "pm.test(\"Cookie HttpOnly\", () => pm.expect(pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\" \")).to.include(\"HttpOnly\"));"
            ]
          }
        }
