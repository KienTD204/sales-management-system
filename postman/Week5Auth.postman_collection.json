    {
      "name": "Đăng nhập ADMIN",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{preauth_csrf}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const response = pm.response.json();",
              "pm.test(\"JSON envelope\", () => pm.expect(response).to.have.property(\"status\"));",
              "if (pm.response.code === 200) {",
              "pm.environment.set(\"admin_token\", response.data.token);",
              "}",
              "pm.test(\"Đúng vai trò và điều hướng\", () => { pm.expect(response.data.role_name).to.eql(\"ADMIN\"); pm.expect(response.redirect_url).to.eql(\"/admin\"); });",
              "pm.test(\"Không trả hash\", () => pm.expect(JSON.stringify(response)).not.to.include(\"password_hash\"));",
              "pm.test(\"Cookie HttpOnly\", () => pm.expect(pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\" \")).to.include(\"HttpOnly\"));"
            ]
          }
        }
      ]
    },
