      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.environment.set(\"branch\",body.data.find(row=>row.is_default).branch_id);"
            ]
          }
        }
      ]
    },
