{
  "info": {
    "name": "ShopFlow gói / chi nhánh / chấm công / lương",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy trên demo riêng có seed: shop1 Pro, shop2 Standard. Tạo dữ liệu PMPL; cần delay request ít nhất 1000ms cho ca vào/ra."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "CSRF owner",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.environment.set(\"csrf\",body.data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"owner.demo@example.com\", \"password\": \"DemoOwner123!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.environment.set(\"owner_token\",body.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Pro giá và hạn mức",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": "{{base_url}}/api/subscription"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test(\"Giá Pro\",()=>pm.expect(body.data.prices.PRO.amount).to.eql(\"500000.00\"));",
              "pm.test(\"30 chấm công và tài khoản không giới hạn\",()=>{pm.expect(body.data.limits.attendance).to.eql(30);pm.expect(body.data.limits.accounts).to.eql(null);});",
              "const now=new Date();pm.environment.set(\"run\",\"PMPL\"+Date.now());pm.environment.set(\"year\",now.getUTCFullYear());pm.environment.set(\"month\",now.getUTCMonth()+1);pm.environment.set(\"effective\",now.toISOString().slice(0,8)+\"01T00:00:00Z\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách chi nhánh",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
